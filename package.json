{
  "name": "tesser-explore",
  "private": true,
  "description": "Test harness for the tesser-explore skills (tesser-benchmark, tesser-discover). The skills have no runtime npm dependencies; this package exists only to run the deterministic gates (tests/).",
  "type": "module",
  "scripts": {
    "pretest": "python3 -m venv .venv && .venv/bin/python3 -m pip install --quiet --disable-pip-version-check -r requirements.txt",
    "test": "PATH=\"$PWD/.venv/bin:$PATH\" vitest run",
    "score": "node tests/scoreboard/cli.ts",
    "judge": "node tests/scoreboard/judge.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "js-yaml": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
